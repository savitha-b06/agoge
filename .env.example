# Copy to .env and fill in. .env is gitignored.

ANTHROPIC_API_KEY=sk-ant-...

# Cheap model for the nightly note, stronger one for weekly planning.
AGOGE_MODEL_FAST=claude-haiku-4-5-20251001
AGOGE_MODEL_SMART=claude-sonnet-5

# COROS MCP endpoint (official, read-only as of July 2026)
COROS_MCP_URL=https://mcp.coros.com/mcp

# Where state lives. Keep it out of the repo.
AGOGE_DATA_DIR=./data
AGOGE_ATHLETE_FILE=./athlete.yaml

# Optional: notify channel for the nightly push (leave blank for now)
AGOGE_NOTIFY_WEBHOOK=

# Telegram bot (optional). agoge telegram long-polls; no webhook needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# --- Cronometer (optional) -------------------------------------------------
# Requires the separate GPLv2 `cronosync` binary. See DEPLOY.md.
CRONOSYNC_BIN=/home/agoge/bin/cronosync
CRONOMETER_USERNAME=
CRONOMETER_PASSWORD=
# Only needed once Cronometer ships a frontend update and login starts failing:
CRONOMETER_GWT_PERMUTATION=
CRONOMETER_GWT_HEADER=
